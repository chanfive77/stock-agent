# ─── LLM (OpenAI) ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# 분석/리포트 생성에 사용할 모델
OPENAI_MODEL=gpt-4o-mini

# ─── 이메일 (Gmail SMTP) ────────────────────────────────────────
# Gmail 주소 (발신자)
GMAIL_ADDRESS=your_account@gmail.com
# Gmail 앱 비밀번호 (16자리, 일반 비밀번호 아님)
# 생성: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 수신자 (콤마로 여러 명 구분)
MAIL_RECIPIENTS=your_account@gmail.com
